{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:architecture-advisor:model:1.0",
  "title": "Architecture Advisor finite optimization model",
  "description": "Additional semantic checks for unique IDs, references, aggregate limits, and reserved names are performed by scripts/optimize.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "metric_definitions",
    "decisions",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "metric_definitions": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "description"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "budget_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000000
    },
    "evidence": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "currency",
        "currency_scale",
        "horizon_months",
        "cost_basis",
        "cost_completeness"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "currency_scale": {
          "enum": [
            1,
            10,
            100,
            1000,
            10000,
            100000,
            1000000,
            10000000,
            100000000,
            1000000000
          ]
        },
        "horizon_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200
        },
        "cost_basis": {
          "enum": [
            "incremental",
            "total"
          ]
        },
        "cost_completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "assumptions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "one_time_cost",
        "monthly_cost",
        "metrics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "one_time_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000000
        },
        "monthly_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000000
        },
        "metrics": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -1000000000000000000,
            "maximum": 1000000000000000000
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "incompatible_with": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "op",
        "value",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "metric": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            "=="
          ]
        },
        "value": {
          "type": "integer",
          "minimum": -1000000000000000000,
          "maximum": 1000000000000000000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
